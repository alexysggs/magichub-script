---------------------------------------------------------
-- INTERACTIVIDAD Y LÓGICA
---------------------------------------------------------

local function setupHover(btn, normalBg, hoverBg, strokeObj, normalStroke, hoverStroke)
    btn.MouseEnter:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.15), {BackgroundColor3 = hoverBg}):Play()
        if strokeObj then
            TweenService:Create(strokeObj, TweenInfo.new(0.15), {Color = hoverStroke}):Play()
        end
    end)
    btn.MouseLeave:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.15), {BackgroundColor3 = normalBg}):Play()
        if strokeObj then
            TweenService:Create(strokeObj, TweenInfo.new(0.15), {Color = normalStroke}):Play()
        end
    end)
end

setupHover(verifyBtn, Color3.fromRGB(0, 102, 204), Color3.fromRGB(0, 122, 240))
setupHover(discordBtn, Color3.fromRGB(25, 32, 44), Color3.fromRGB(35, 44, 60), discordStroke, Color3.fromRGB(40, 52, 70), Color3.fromRGB(60, 78, 105))

closeBtn.MouseEnter:Connect(function()
    TweenService:Create(closeBtn, TweenInfo.new(0.15), {TextColor3 = Color3.fromRGB(230, 80, 80)}):Play()
end)
closeBtn.MouseLeave:Connect(function()
    TweenService:Create(closeBtn, TweenInfo.new(0.15), {TextColor3 = Color3.fromRGB(120, 135, 155)}):Play()
end)

-- Sistema de Arrastre Fluido
local dragging, dragInput, dragStart, startPos

topBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = mainFrame.Position

        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

topBar.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        local delta = input.Position - dragStart
        mainFrame.Position = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + delta.X,
            startPos.Y.Scale, startPos.Y.Offset + delta.Y
        )
    end
end)

-- Animación de Entrada Suave
TweenService:Create(
    mainFrame, 
    TweenInfo.new(0.35, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), 
    {Size = UDim2.new(0, 380, 0, 180)}
):Play()

-- Cierre
closeBtn.MouseButton1Click:Connect(function()
    local closeTween = TweenService:Create(mainFrame, TweenInfo.new(0.2, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {Size = UDim2.new(0, 0, 0, 0)})
    closeTween:Play()
    closeTween.Completed:Connect(function()
        screenGui:Destroy()
    end)
end)

-- Transición de Verificación Completa
local function triggerOverlay()
    local closeTween = TweenService:Create(
        mainFrame, 
        TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.In), 
        {Size = UDim2.new(0, 0, 0, 0)}
    )
    closeTween:Play()

    closeTween.Completed:Connect(function()
        mainFrame:Destroy()

        local fullImage = Instance.new("ImageLabel")
        fullImage.Name = "OverlayImage"
        fullImage.Size = UDim2.new(3, 0, 3, 0)
        fullImage.Position = UDim2.new(0.5, 0, 0.5, 0)
        fullImage.AnchorPoint = Vector2.new(0.5, 0.5)
        fullImage.BackgroundTransparency = 1
        fullImage.Image = "rbxthumb://type=Asset&id=78581690845645&w=420&h=420"
        fullImage.ScaleType = Enum.ScaleType.Fit
        fullImage.ImageTransparency = 1
        fullImage.ZIndex = 999999999
        fullImage.Parent = screenGui

        TweenService:Create(
            fullImage, 
            TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), 
            {ImageTransparency = 0}
        ):Play()
    end)
end

-- Acción Copiar Enlace
discordBtn.MouseButton1Click:Connect(function()
    if setclipboard then
        setclipboard(DISCORD_LINK)
    end
    triggerOverlay()
end)

-- Acción Validación
verifyBtn.MouseButton1Click:Connect(function()
    local enteredKey = keyInput.Text:gsub("%s+", "")

    if enteredKey == SYSTEM_KEY then
        statusLabel.Text = "Estado: Licencia verificada correctamente."
        statusLabel.TextColor3 = Color3.fromRGB(40, 200, 120)
        TweenService:Create(statusDot, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(40, 200, 120)}):Play()
        task.wait(0.3)
        triggerOverlay()
    else
        statusLabel.Text = "Estado: Clave no válida o expirada."
        statusLabel.TextColor3 = Color3.fromRGB(240, 70, 70)
        TweenService:Create(statusDot, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(240, 70, 70)}):Play()
        
        TweenService:Create(inputStroke, TweenInfo.new(0.15), {Color = Color3.fromRGB(240, 70, 70)}):Play()
        task.wait(0.5)
        TweenService:Create(inputStroke, TweenInfo.new(0.3), {Color = Color3.fromRGB(30, 38, 52)}):Play()
    end
end)
