-- Roblox Executor - Key System Minimalista (MagicHub)
local TweenService = game:GetService("TweenService")
local CoreGui = game:GetService("CoreGui")

local parentTarget = (gethui and gethui()) or CoreGui

if parentTarget:FindFirstChild("MagicHub_KeySystem") then
	parentTarget.MagicHub_KeySystem:Destroy()
end

local screenGui = Instance.new("ScreenGui")
screenGui.Name = "MagicHub_KeySystem"
screenGui.ResetOnSpawn = false
screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
screenGui.Parent = parentTarget

local mainFrame = Instance.new("Frame")
mainFrame.Name = "MainFrame"
mainFrame.Size = UDim2.new(0, 360, 0, 200)
mainFrame.Position = UDim2.new(0.5, -180, 0.5, -80)
mainFrame.BackgroundColor3 = Color3.fromRGB(18, 18, 20)
mainFrame.BorderSizePixel = 0
mainFrame.Active = true
mainFrame.Draggable = true
mainFrame.BackgroundTransparency = 1
mainFrame.Parent = screenGui

local mainCorner = Instance.new("UICorner")
mainCorner.CornerRadius = UDim.new(0, 16)
mainCorner.Parent = mainFrame

local mainStroke = Instance.new("UIStroke")
mainStroke.Color = Color3.fromRGB(255, 255, 255)
mainStroke.Transparency = 1
mainStroke.Thickness = 1
mainStroke.Parent = mainFrame

local titleContainer = Instance.new("Frame")
titleContainer.Name = "TitleContainer"
titleContainer.Size = UDim2.new(1, -40, 0, 30)
titleContainer.Position = UDim2.new(0, 20, 0, 18)
titleContainer.BackgroundTransparency = 1
titleContainer.ClipsDescendants = true
titleContainer.Parent = mainFrame

local titleLabel = Instance.new("TextLabel")
titleLabel.Name = "TitleLabel"
titleLabel.Size = UDim2.new(1, 0, 1, 0)
titleLabel.Position = UDim2.new(0, -20, 0, 0)
titleLabel.BackgroundTransparency = 1
titleLabel.Text = 'Key System  ·  <font color="#007AFF">MagicHub</font>'
titleLabel.TextColor3 = Color3.fromRGB(240, 240, 245)
titleLabel.Font = Enum.Font.GothamBold
titleLabel.TextSize = 14
titleLabel.RichText = true
titleLabel.TextXAlignment = Enum.TextXAlignment.Left
titleLabel.TextTransparency = 1
titleLabel.Parent = titleContainer

local keyInput = Instance.new("TextBox")
keyInput.Name = "KeyInput"
keyInput.Size = UDim2.new(1, -40, 0, 42)
keyInput.Position = UDim2.new(0, 20, 0, 62)
keyInput.BackgroundColor3 = Color3.fromRGB(26, 26, 30)
keyInput.BackgroundTransparency = 1
keyInput.PlaceholderText = "Paste key here..."
keyInput.PlaceholderColor3 = Color3.fromRGB(90, 90, 100)
keyInput.Text = ""
keyInput.TextColor3 = Color3.fromRGB(240, 240, 245)
keyInput.Font = Enum.Font.GothamMedium
keyInput.TextSize = 13
keyInput.ClearTextOnFocus = false
keyInput.TextTransparency = 1
keyInput.Parent = mainFrame

local inputCorner = Instance.new("UICorner")
inputCorner.CornerRadius = UDim.new(0, 10)
inputCorner.Parent = keyInput

local inputStroke = Instance.new("UIStroke")
inputStroke.Color = Color3.fromRGB(255, 255, 255)
inputStroke.Transparency = 1
inputStroke.Thickness = 1
inputStroke.Parent = keyInput

-- Botón Get Key
local getKeyBtn = Instance.new("TextButton")
getKeyBtn.Name = "GetKeyButton"
getKeyBtn.Size = UDim2.new(0.44, 0, 0, 40)
getKeyBtn.Position = UDim2.new(0, 20, 0, 118)
getKeyBtn.BackgroundColor3 = Color3.fromRGB(28, 28, 32)
getKeyBtn.BackgroundTransparency = 1
getKeyBtn.Text = "Get Key"
getKeyBtn.TextColor3 = Color3.fromRGB(180, 180, 190)
getKeyBtn.TextTransparency = 1
getKeyBtn.Font = Enum.Font.GothamMedium
getKeyBtn.TextSize = 12
getKeyBtn.AutoButtonColor = false
getKeyBtn.Parent = mainFrame

local getKeyCorner = Instance.new("UICorner")
getKeyCorner.CornerRadius = UDim.new(0, 10)
getKeyCorner.Parent = getKeyBtn

-- Botón Submit / Continue
local submitBtn = Instance.new("TextButton")
submitBtn.Name = "SubmitButton"
submitBtn.Size = UDim2.new(0.44, 0, 0, 40)
submitBtn.Position = UDim2.new(0.56, -20, 0, 118)
submitBtn.BackgroundColor3 = Color3.fromRGB(0, 122, 255)
submitBtn.BackgroundTransparency = 1
submitBtn.Text = "Continue"
submitBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
submitBtn.TextTransparency = 1
submitBtn.Font = Enum.Font.GothamBold
submitBtn.TextSize = 12
submitBtn.AutoButtonColor = false
submitBtn.Parent = mainFrame

local submitCorner = Instance.new("UICorner")
submitCorner.CornerRadius = UDim.new(0, 10)
submitCorner.Parent = submitBtn

local statusLabel = Instance.new("TextLabel")
statusLabel.Size = UDim2.new(1, -40, 0, 18)
statusLabel.Position = UDim2.new(0, 20, 0, 168)
statusLabel.BackgroundTransparency = 1
statusLabel.Text = ""
statusLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
statusLabel.Font = Enum.Font.Gotham
statusLabel.TextSize = 11
statusLabel.Parent = mainFrame

-- ANIMACIONES DE ENTRADA
TweenService:Create(mainFrame, TweenInfo.new(0.35, Enum.EasingStyle.Cubic, Enum.EasingDirection.Out), {
	BackgroundTransparency = 0,
	Position = UDim2.new(0.5, -180, 0.5, -100)
}):Play()
TweenService:Create(mainStroke, TweenInfo.new(0.35), {Transparency = 0.92}):Play()

TweenService:Create(keyInput, TweenInfo.new(0.3), {BackgroundTransparency = 0, TextTransparency = 0}):Play()
TweenService:Create(inputStroke, TweenInfo.new(0.3), {Transparency = 0.94}):Play()
TweenService:Create(getKeyBtn, TweenInfo.new(0.3), {BackgroundTransparency = 0, TextTransparency = 0}):Play()
TweenService:Create(submitBtn, TweenInfo.new(0.3), {BackgroundTransparency = 0, TextTransparency = 0}):Play()

TweenService:Create(titleLabel, TweenInfo.new(0.45, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
	Position = UDim2.new(0, 0, 0, 0),
	TextTransparency = 0
}):Play()

-- ACCIONES
getKeyBtn.MouseButton1Click:Connect(function()
	local keyLink = "https://magichub-go.lovable.app"
	if setclipboard then
		setclipboard(keyLink)
		statusLabel.TextColor3 = Color3.fromRGB(120, 220, 140)
		statusLabel.Text = "Copied to clipboard!"
	else
		statusLabel.TextColor3 = Color3.fromRGB(255, 180, 60)
		statusLabel.Text = keyLink
	end
end)

local VALID_KEY = "MHUB2026TT"

submitBtn.MouseButton1Click:Connect(function()
	if keyInput.Text == VALID_KEY then
		statusLabel.TextColor3 = Color3.fromRGB(120, 220, 140)
		statusLabel.Text = "Access Granted"
		
		task.wait(0.3)
		local exitTween = TweenService:Create(mainFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
			BackgroundTransparency = 1,
			Position = UDim2.new(0.5, -180, 0.5, -80)
		})
		TweenService:Create(mainStroke, TweenInfo.new(0.2), {Transparency = 1}):Play()
		TweenService:Create(keyInput, TweenInfo.new(0.2), {BackgroundTransparency = 1, TextTransparency = 1}):Play()
		TweenService:Create(getKeyBtn, TweenInfo.new(0.2), {BackgroundTransparency = 1, TextTransparency = 1}):Play()
		TweenService:Create(submitBtn, TweenInfo.new(0.2), {BackgroundTransparency = 1, TextTransparency = 1}):Play()
		TweenService:Create(titleLabel, TweenInfo.new(0.2), {TextTransparency = 1}):Play()
		
		exitTween:Play()
		exitTween.Completed:Connect(function()
			screenGui:Destroy()
			
			-- Ejecución remota del script RAW de GitHub
			local success, err = pcall(function()
				loadstring(game:HttpGet("https://raw.githubusercontent.com/alex2013palomo-byte/luamaser/main/masterlua.raw"))()
			end)
			
			if not success then
				warn("Error al cargar el script:", err)
			end
		end)
	else
		statusLabel.TextColor3 = Color3.fromRGB(255, 90, 90)
		statusLabel.Text = "Invalid key. Try again."
		
		local origPos = UDim2.new(0.5, -180, 0.5, -100)
		task.spawn(function()
			for i = 1, 3 do
				mainFrame.Position = origPos + UDim2.new(0, -4, 0, 0)
				task.wait(0.04)
				mainFrame.Position = origPos + UDim2.new(0, 4, 0, 0)
				task.wait(0.04)
			end
			mainFrame.Position = origPos
		end)
	end
end)
