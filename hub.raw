-- Roblox Executor - Key System Dinámico (MagicHub)
local TweenService = game:GetService("TweenService")
local CoreGui = game:GetService("CoreGui")
local Players = game:GetService("Players")
local HttpService = game:GetService("HttpService")

local LocalPlayer = Players.LocalPlayer
local parentTarget = (gethui and gethui()) or CoreGui

if parentTarget:FindFirstChild("MagicHub_KeySystem_v2") then
	parentTarget.MagicHub_KeySystem_v2:Destroy()
end

local screenGui = Instance.new("ScreenGui")
screenGui.Name = "MagicHub_KeySystem_v2"
screenGui.ResetOnSpawn = false
screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
screenGui.Parent = parentTarget

-- Configuración de Enlaces
local KEY_LINK = "https://magichub-go.lovable.app/"
local JSON_KEYS_URL = "https://magichub-go.lovable.app/keysis.json"

-- Función para verificar la clave desde el JSON remoto
local function verifyKeyOnline(userKey)
	local success, response = pcall(function()
		return game:HttpGet(JSON_KEYS_URL)
	end)

	if not success or not response then
		return false, "Error de conexión al verificar la clave."
	end

	local parseSuccess, data = pcall(function()
		return HttpService:JSONDecode(response)
	end)

	if not parseSuccess or not data then
		return false, "Error al procesar los datos del servidor."
	end

	-- Soporte si el JSON es una lista: ["KEY1", "KEY2"]
	if type(data) == "table" then
		for _, key in ipairs(data) do
			if tostring(key) == userKey then
				return true
			end
		end
		-- Soporte si el JSON tiene clave directa: { "key": "VALOR" } o { "keys": [...] }
		if data.key and tostring(data.key) == userKey then
			return true
		elseif type(data.keys) == "table" then
			for _, key in ipairs(data.keys) do
				if tostring(key) == userKey then
					return true
				end
			end
		end
	end

	return false, "Clave incorrecta. Inténtalo de nuevo."
end

-- 2. Notificación Superior Central Flotante
local topNotification = Instance.new("Frame")
topNotification.Name = "TopNotification"
topNotification.Size = UDim2.new(0, 280, 0, 38)
topNotification.Position = UDim2.new(0.5, -140, 0, -50)
topNotification.BackgroundColor3 = Color3.fromRGB(22, 24, 30)
topNotification.BorderSizePixel = 0
topNotification.Parent = screenGui

local notifCorner = Instance.new("UICorner")
notifCorner.CornerRadius = UDim.new(0, 8)
notifCorner.Parent = topNotification

local notifStroke = Instance.new("UIStroke")
notifStroke.Color = Color3.fromRGB(0, 122, 255)
notifStroke.Thickness = 1
notifStroke.Parent = topNotification

local notifText = Instance.new("TextLabel")
notifText.Size = UDim2.new(1, 0, 1, 0)
notifText.BackgroundTransparency = 1
notifText.Text = ""
notifText.TextColor3 = Color3.fromRGB(240, 240, 245)
notifText.Font = Enum.Font.GothamMedium
notifText.TextSize = 12
notifText.Parent = topNotification

local function showNotification(text, color, strokeColor)
	notifText.Text = text
	notifText.TextColor3 = color or Color3.fromRGB(240, 240, 245)
	notifStroke.Color = strokeColor or Color3.fromRGB(0, 122, 255)
	
	topNotification:TweenPosition(
		UDim2.new(0.5, -140, 0, 18),
		Enum.EasingDirection.Out,
		Enum.EasingStyle.Quart,
		0.3,
		true
	)
	
	task.delay(3, function()
		topNotification:TweenPosition(
			UDim2.new(0.5, -140, 0, -50),
			Enum.EasingDirection.In,
			Enum.EasingStyle.Quart,
			0.3,
			true
		)
	end)
end

