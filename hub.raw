local notifCorner = Instance.new("UICorner")
notifCorner.CornerRadius = UDim.new(0, 8)
notifCorner.Parent = topNotification

local notifStroke = Instance.new("UIStroke")
notifStroke.Color = Color3.fromRGB(0, 122, 255)
notifStroke.Thickness = 1
notifStroke.Parent = topNotification

local notifText = Instance.new("TextLabel")
notifText.Size = UDim2.new(1, 0, 1, 0)
notifText.BackgroundTransparency = 1
notifText.Text = ""
notifText.TextColor3 = Color3.fromRGB(240, 240, 245)
notifText.Font = Enum.Font.GothamMedium
notifText.TextSize = 12
notifText.Parent = topNotification

local function showNotification(text, color, strokeColor)
	notifText.Text = text
	notifText.TextColor3 = color or Color3.fromRGB(240, 240, 245)
	notifStroke.Color = strokeColor or Color3.fromRGB(0, 122, 255)
	
	topNotification:TweenPosition(
		UDim2.new(0.5, -140, 0, 18),
		Enum.EasingDirection.Out,
		Enum.EasingStyle.Quart,
		0.3,
		true
	)
	
	task.delay(3, function()
		topNotification:TweenPosition(
			UDim2.new(0.5, -140, 0, -50),
			Enum.EasingDirection.In,
			Enum.EasingStyle.Quart,
			0.3,
			true
		)
	end)
end

