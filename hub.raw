-- Roblox Executor - Key System Dinámico (MagicHub)
local TweenService = game:GetService("TweenService")
local CoreGui = game:GetService("CoreGui")
local Players = game:GetService("Players")
local HttpService = game:GetService("HttpService")

local LocalPlayer = Players.LocalPlayer
local parentTarget = (gethui and gethui()) or CoreGui

if parentTarget:FindFirstChild("MagicHub_KeySystem_v2") then
	parentTarget.MagicHub_KeySystem_v2:Destroy()
end
if parentTarget:FindFirstChild("MagicHub_VersionSelector") then
	parentTarget.MagicHub_VersionSelector:Destroy()
end

-- Configuración de Enlaces
local KEY_LINK = "https://magichub-go.lovable.app/"
local JSON_KEYS_URL = "https://magichub-go.lovable.app/keysis.json"

-- URLs de los Scripts según la versión
local SCRIPT_V3_URL = "https://raw.githubusercontent.com/alex2013palomo-byte/luamaser/main/masterlua.raw"
local SCRIPT_V5_URL = "https://raw.githubusercontent.com/alexysggs/luamaser/main/mhubv4.raw"

-- Función genérica para ejecutar el script según la URL elegida
local function executeMainScript(url)
	local targetUrl = url or SCRIPT_V3_URL
	local success, err = pcall(function()
		loadstring(game:HttpGet(targetUrl))()
	end)
	if not success then
		warn("Error al cargar el script:", err)
	end
end

-- Función para mostrar la notificación flotante VIP
local function showVIPNotification()
	local vipGui = Instance.new("ScreenGui")
	vipGui.Name = "MagicHub_VIP_Notif"
	vipGui.ResetOnSpawn = false
	vipGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	vipGui.Parent = parentTarget

	local vipNotification = Instance.new("Frame")
	vipNotification.Name = "VipNotification"
	vipNotification.Size = UDim2.new(0, 240, 0, 38)
	vipNotification.Position = UDim2.new(0.5, -120, 0, -50)
	vipNotification.BackgroundColor3 = Color3.fromRGB(22, 24, 30)
	vipNotification.BorderSizePixel = 0
	vipNotification.Parent = vipGui

	local vipCorner = Instance.new("UICorner")
	vipCorner.CornerRadius = UDim.new(0, 8)
	vipCorner.Parent = vipNotification

	local vipStroke = Instance.new("UIStroke")
	vipStroke.Color = Color3.fromRGB(100, 220, 130)
	vipStroke.Thickness = 1
	vipStroke.Parent = vipNotification

	local vipText = Instance.new("TextLabel")
	vipText.Size = UDim2.new(1, 0, 1, 0)
	vipText.BackgroundTransparency = 1
	vipText.Text = "★ Acceso VIP Concedido"
	vipText.TextColor3 = Color3.fromRGB(100, 220, 130)
	vipText.Font = Enum.Font.GothamBold
	vipText.TextSize = 13
	vipText.Parent = vipNotification

	vipNotification:TweenPosition(
		UDim2.new(0.5, -120, 0, 18),
		Enum.EasingDirection.Out,
		Enum.EasingStyle.Quart,
		0.3,
		true
	)

	task.delay(2.5, function()
		vipNotification:TweenPosition(
			UDim2.new(0.5, -120, 0, -50),
			Enum.EasingDirection.In,
			Enum.EasingStyle.Quart,
			0.3,
			true
		)
		task.wait(0.3)
		vipGui:Destroy()
	end)
end

-- Ventana flotante para seleccionar versión (Soporta VIP y Usuario Normal)
local function openVersionSelector(isVIP)
	local selectorGui = Instance.new("ScreenGui")
	selectorGui.Name = "MagicHub_VersionSelector"
	selectorGui.ResetOnSpawn = false
	selectorGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	selectorGui.Parent = parentTarget

	local selectorFrame = Instance.new("Frame")
	selectorFrame.Name = "SelectorFrame"
	selectorFrame.Size = UDim2.new(0, 320, 0, 140)
	selectorFrame.Position = UDim2.new(0.5, -160, 0.5, -70)
	selectorFrame.BackgroundColor3 = Color3.fromRGB(18, 19, 23)
	selectorFrame.BorderSizePixel = 0
	selectorFrame.Active = true
	selectorFrame.Draggable = true
	selectorFrame.Parent = selectorGui

	local selCorner = Instance.new("UICorner")
	selCorner.CornerRadius = UDim.new(0, 12)
	selCorner.Parent = selectorFrame

	local selStroke = Instance.new("UIStroke")
	selStroke.Color = isVIP and Color3.fromRGB(100, 220, 130) or Color3.fromRGB(0, 122, 255)
	selStroke.Thickness = 1
	selStroke.Parent = selectorFrame

	local titleLabel = Instance.new("TextLabel")
	titleLabel.Size = UDim2.new(1, 0, 0, 35)
	titleLabel.Position = UDim2.new(0, 0, 0, 10)
	titleLabel.BackgroundTransparency = 1
	titleLabel.Text = isVIP and "★ Acceso VIP Detectado" or "Selecciona Versión"
	titleLabel.TextColor3 = isVIP and Color3.fromRGB(100, 220, 130) or Color3.fromRGB(0, 122, 255)
	titleLabel.Font = Enum.Font.GothamBold
	titleLabel.TextSize = 14
	titleLabel.Parent = selectorFrame

	local subTitleLabel = Instance.new("TextLabel")
	subTitleLabel.Size = UDim2.new(1, 0, 0, 20)
	subTitleLabel.Position = UDim2.new(0, 0, 0, 40)
	subTitleLabel.BackgroundTransparency = 1
	subTitleLabel.Text = "¿Qué versión prefieres ejecutar?"
	subTitleLabel.TextColor3 = Color3.fromRGB(180, 185, 200)
	subTitleLabel.Font = Enum.Font.GothamMedium
	subTitleLabel.TextSize = 12
	subTitleLabel.Parent = selectorFrame

	local btnV3 = Instance.new("TextButton")
	btnV3.Name = "BtnV3"
	btnV3.Size = UDim2.new(0.5, -18, 0, 38)
	btnV3.Position = UDim2.new(0, 12, 0, 80)
	btnV3.BackgroundColor3 = Color3.fromRGB(28, 30, 36)
	btnV3.BorderSizePixel = 0
	btnV3.Text = "MagicHub V3"
	btnV3.TextColor3 = Color3.fromRGB(240, 240, 245)
	btnV3.Font = Enum.Font.GothamBold
	btnV3.TextSize = 12
	btnV3.AutoButtonColor = false
	btnV3.Parent = selectorFrame

	local btnV3Corner = Instance.new("UICorner")
	btnV3Corner.CornerRadius = UDim.new(0, 8)
	btnV3Corner.Parent = btnV3

	local btnV5 = Instance.new("TextButton")
	btnV5.Name = "BtnV5"
	btnV5.Size = UDim2.new(0.5, -18, 0, 38)
	btnV5.Position = UDim2.new(0.5, 6, 0, 80)
	btnV5.BackgroundColor3 = Color3.fromRGB(0, 122, 255)
	btnV5.BorderSizePixel = 0
	btnV5.Text = "MagicHub V5 (Beta)"
	btnV5.TextColor3 = Color3.fromRGB(255, 255, 255)
	btnV5.Font = Enum.Font.GothamBold
	btnV5.TextSize = 12
	btnV5.AutoButtonColor = false
	btnV5.Parent = selectorFrame

	local btnV5Corner = Instance.new("UICorner")
	btnV5Corner.CornerRadius = UDim.new(0, 8)
	btnV5Corner.Parent = btnV5

	btnV3.MouseButton1Click:Connect(function()
		selectorGui:Destroy()
		if isVIP then showVIPNotification() end
		executeMainScript(SCRIPT_V3_URL)
	end)

	btnV5.MouseButton1Click:Connect(function()
		selectorGui:Destroy()
		if isVIP then showVIPNotification() end
		executeMainScript(SCRIPT_V5_URL)
	end)
end

-- Comprobar si el usuario está en la lista blanca (always_allowed)
local isAlwaysAllowed = false
local fetchSuccess, response = pcall(function()
	return game:HttpGet(JSON_KEYS_URL)
end)

if fetchSuccess and response then
	local parseSuccess, data = pcall(function()
		return HttpService:JSONDecode(response)
	end)

	if parseSuccess and data and LocalPlayer and type(data.always_allowed) == "table" then
		local currentUsername = string.lower(LocalPlayer.Name)
		for _, allowedUser in ipairs(data.always_allowed) do
			local cleanUser = string.lower(tostring(allowedUser)):gsub("^@", "")
			if cleanUser == currentUsername then
				isAlwaysAllowed = true
				break
			end
		end
	end
end

-- Si el usuario es VIP, abrir selector directamente
if isAlwaysAllowed then
	openVersionSelector(true)
	return
end

-- Crear Interfaz Gráfica Normal (Solo para usuarios no VIP)
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "MagicHub_KeySystem_v2"
screenGui.ResetOnSpawn = false
screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
screenGui.Parent = parentTarget

-- Función para verificar la clave desde el JSON
local function verifyKeyOnline(userKey)
	if userKey == "" then
		return false, "Por favor, introduce una clave."
	end

	local reqSuccess, reqResponse = pcall(function()
		return game:HttpGet(JSON_KEYS_URL)
	end)

	if not reqSuccess or not reqResponse then
		return false, "Error de conexión al verificar."
	end

	local parseSuccess, data = pcall(function()
		return HttpService:JSONDecode(reqResponse)
	end)

	if not parseSuccess or not data then
		return false, "Error al procesar datos del servidor."
	end

	if data.key and tostring(data.key) == userKey then
		return true, "Acceso concedido."
	end

	if type(data.keys) == "table" then
		for _, item in ipairs(data.keys) do
			if type(item) == "table" and item.key and tostring(item.key) == userKey then
				return true, "Acceso concedido."
			elseif type(item) == "string" and item == userKey then
				return true, "Acceso concedido."
			end
		end
	end

	return false, "Clave incorrecta. Inténtalo de nuevo."
end

