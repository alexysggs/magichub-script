-- Acciones de los Botones
getKeyBtn.MouseButton1Click:Connect(function()
	if setclipboard then
		setclipboard(KEY_LINK)
		showNotification("¡Enlace copiado al portapapeles!", Color3.fromRGB(100, 220, 130), Color3.fromRGB(100, 220, 130))
	else
		showNotification("Link: " .. KEY_LINK, Color3.fromRGB(255, 180, 60), Color3.fromRGB(255, 180, 60))
	end
end)

submitBtn.MouseButton1Click:Connect(function()
	local userEnteredKey = keyInput.Text:gsub("%s+", "")
	
	showNotification("Verificando...", Color3.fromRGB(140, 145, 160), Color3.fromRGB(140, 145, 160))

	task.spawn(function()
		local isValid, message = verifyKeyOnline(userEnteredKey)
		
		if isValid then
			showNotification(message .. " Abriendo selector...", Color3.fromRGB(100, 220, 130), Color3.fromRGB(100, 220, 130))
			
			task.wait(0.4)
			
			local exitTween = TweenService:Create(mainFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
				Position = UDim2.new(0.5, -180, 0.5, -50),
				BackgroundTransparency = 1
			})
			
			exitTween:Play()
			exitTween.Completed:Connect(function()
				screenGui:Destroy()
				openVersionSelector(false)
			end)
		else
			showNotification(message or "Acceso denegado.", Color3.fromRGB(255, 90, 90), Color3.fromRGB(255, 90, 90))
			
			local origPos = UDim2.new(0.5, -180, 0.5, -75)
			for i = 1, 3 do
				mainFrame.Position = origPos + UDim2.new(0, -4, 0, 0)
				task.wait(0.04)
				mainFrame.Position = origPos + UDim2.new(0, 4, 0, 0)
				task.wait(0.04)
			end
			mainFrame.Position = origPos
		end
	end)
end)
